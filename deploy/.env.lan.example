# Backward-compatible copy. For a new deployment, copy this file to
# deploy/.env.production and use the production deployment guide.
# This file is intentionally safe to commit because every secret is a
# placeholder. Never commit deploy/.env.production.
COMPOSE_PROJECT_NAME=longyun-agent
RELEASE_TAG=v1.11.0-rc1

# A stable intranet DNS name is required. It must match the TLS certificate.
PUBLIC_PLATFORM_URL=https://longyun-agent.institute.local
PUBLIC_PLATFORM_HOST=longyun-agent.institute.local
HTTPS_PORT=443
TLS_CERT_FILE=./deploy/certs/server.crt
TLS_KEY_FILE=./deploy/certs/server.key

# Replace every password with a unique 24+ character random secret before the
# first startup. Do not reuse any local-demo password.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
APP_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_RESEARCHER_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_PROCESSOR_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_FIELD_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

# Data governance defaults.
ENABLE_SOURCE_DEDUPLICATION=true
ENABLE_LEGACY_DEMO_SEEDS=false

# Local model and document-parser settings. Preload models through the warmup
# profile before the pilot is opened to researchers.
BGE_M3_MODEL_SOURCE=modelscope
BGE_M3_MODEL_REPOSITORY=BAAI/bge-m3
BGE_M3_HF_ENDPOINT=
MINERU_MODEL_SOURCE=modelscope
MINERU_BACKEND=pipeline
MINERU_PARSE_TIMEOUT_SECONDS=900
# This is intentionally longer than MINERU_PARSE_TIMEOUT_SECONDS.
MINERU_REQUEST_TIMEOUT_SECONDS=960
# CPU-only host safety: process one document through MinerU/Docling/OCR at a time.
KNOWLEDGE_DOCUMENT_CONCURRENCY=1
DOCLING_DOCUMENT_TIMEOUT_SECONDS=600

# Optional candidate-gene annotation file, mounted read-only from reference/.
RICE_GFF3_PATH=

# External model service used by the desensitized trial sandbox. Never commit
# the real key. Change DATA_ENVIRONMENT to institution_private for a formal
# private-data deployment; that mode blocks private evidence on external APIs.
LONGYUN_LLM_PROVIDER_NAME=CherryIn
LONGYUN_LLM_BASE_URL=https://open.cherryin.net/v1
LONGYUN_LLM_MODEL=agent/qwen3.5-flash
LONGYUN_LLM_API_KEY=
LONGYUN_LLM_ALIAS=longyun-sandbox
LONGYUN_LLM_DEPLOYMENT_MODE=external_api
LONGYUN_RESEARCH_TEXT_PROTOCOL=plain_evidence
LONGYUN_DATA_ENVIRONMENT=institution_private
# Explicit deployment decision: authorized project evidence may leave the
# platform through the configured external provider after acknowledgement.
LONGYUN_ALLOW_EXTERNAL_PRIVATE_EVIDENCE=true
LONGYUN_ALLOW_EXTERNAL_WEB_SEARCH=false
TAVILY_API_KEY=

# ACPs/AIP integration. Enable only after the ACPs-side mTLS reverse proxy is
# installed. The proxy must overwrite X-ACPS-Client-AIC and
# X-ACPS-mTLS-Verified instead of forwarding caller-supplied values.
ACPS_AIP_ENABLED=false
LONGYUN_AIC=
ACPS_REQUIRE_MTLS_PROXY=true
ACPS_IDENTITY_BINDINGS_JSON={}
LONGYUN_ACS_RPC_URL=
LONGYUN_ACS_AMQP_URL=

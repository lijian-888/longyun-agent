# Copy to deploy/.env.production for a new secure intranet deployment.
# See docs/内网生产上线实施手册.md before replacing the values below.
COMPOSE_PROJECT_NAME=longyun-agent
RELEASE_TAG=v1.5.1

## Shared-server default: keep this project off the existing host port 443.
## When a dedicated 443 reverse-proxy route is assigned later, remove :8443 here
## and set HTTPS_PORT=443.
PUBLIC_PLATFORM_URL=https://longyun-agent.institute.local:8443
PUBLIC_PLATFORM_HOST=longyun-agent.institute.local
HTTPS_PORT=8443
TLS_CERT_FILE=./deploy/certs/server.crt
TLS_KEY_FILE=./deploy/certs/server.key

POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
APP_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_RESEARCHER_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_PROCESSOR_PASSWORD=CHANGE_ME_BEFORE_USE
INITIAL_FIELD_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

ENABLE_SOURCE_DEDUPLICATION=true
BGE_M3_MODEL_SOURCE=modelscope
BGE_M3_MODEL_REPOSITORY=BAAI/bge-m3
BGE_M3_HF_ENDPOINT=
MINERU_MODEL_SOURCE=modelscope
MINERU_BACKEND=pipeline
MINERU_PARSE_TIMEOUT_SECONDS=900
# This is intentionally longer than MINERU_PARSE_TIMEOUT_SECONDS.
MINERU_REQUEST_TIMEOUT_SECONDS=960
# CPU-only host safety: process one document through MinerU/Docling/OCR at a time.
KNOWLEDGE_DOCUMENT_CONCURRENCY=1
DOCLING_DOCUMENT_TIMEOUT_SECONDS=600
RICE_GFF3_PATH=

SHENNONG_API_BASE_URL=https://api.agent-tech.cc/api/v1
SHENNONG_MODEL=sn
SHENNONG_API_KEY=
TAVILY_API_KEY=

# ACPs v2.1 pure Inbox/Group. Two independently registered AICs share this
# one Longyun deployment and use separate clientAuth certificates.
ACPS_ENABLED=false
ACPS_ROLE=hybrid
ACPS_TRANSPORT=group
ACPS_LEADER_AIC=
ACPS_PARTNER_AIC=
ACPS_AGENT_NAME=隆耘 Agent 育种智能体
ACPS_AGENT_VERSION=2.0.0
ACPS_PUBLIC_BASE_URL=https://longyun.e-farmer.cn
ACPS_DOCUMENTATION_URL=https://longyun.e-farmer.cn/acps/info
ACPS_DISCOVERY_BASE_URL=
ACPS_RABBITMQ_HOST=
ACPS_RABBITMQ_PORT=5671
ACPS_RABBITMQ_VHOST=acps
# Leave user/password empty for ACPs mTLS EXTERNAL authentication.
ACPS_RABBITMQ_USER=
ACPS_RABBITMQ_PASSWORD=
ACPS_ALLOW_PLAIN_RABBITMQ=false
ACPS_RABBITMQ_AUTH_SERVICE_URL=
ACPS_GROUP_INVITATION_TIMEOUT_SECONDS=300
ACPS_GROUP_MAX_PARTNER_GROUPS=16
ACPS_GROUP_MAX_PARTNERS=8
ACPS_SESSION_OWNER_USERNAME=acps.researcher
# Fill with the Keycloak user UUID (`sub`), or leave blank after the account
# has logged in once and the platform identity binding exists.
ACPS_SESSION_OWNER_SUBJECT=
ACPS_PROVIDER_ORGANIZATION=江西省亿发姆科技发展有限公司
ACPS_PROVIDER_DEPARTMENT=隆耘智能体项目组
ACPS_PROVIDER_NAME=李键
ACPS_PROVIDER_EMAIL=13437975781@163.com
ACPS_PROVIDER_URL=https://longyun.e-farmer.cn/
ACPS_PROVIDER_DOMAIN=e-farmer.cn
ACPS_PROVIDER_DOMAIN_REGISTRATION_NUMBER=REPLACE_WITH_ICP_REGISTRATION
ACPS_PROVIDER_DOMAIN_REGISTRATION_TYPE=ICP
ACPS_PROVIDER_LICENSE=
ACPS_MTLS_ENABLED=true
ACPS_LEADER_CLIENT_CERT_FILE=/data/acps/leader-client.pem
ACPS_LEADER_CLIENT_KEY_FILE=/data/acps/leader-client-key.pem
ACPS_PARTNER_CLIENT_CERT_FILE=/data/acps/partner-client.pem
ACPS_PARTNER_CLIENT_KEY_FILE=/data/acps/partner-client-key.pem
ACPS_TRUST_BUNDLE_FILE=/data/acps/trust-bundle.pem

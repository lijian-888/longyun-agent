{
  "realm": "rice-research",
  "enabled": true,
  "sslRequired": "EXTERNAL",
  "displayName": "隆耘 Agent 育种智能体",
  "loginTheme": "rice-research",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      { "name": "researcher", "description": "Researcher access to published data and private research sessions." },
      { "name": "data_processor", "description": "Can import, review, correct, and publish governed datasets." },
      { "name": "field_admin", "description": "Can maintain templates, field definitions, and rule versions." }
    ]
  },
  "clients": [
    {
      "clientId": "rice-research-web",
      "name": "Longyun Agent Breeding Intelligence Web",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["${PUBLIC_PLATFORM_URL}/*"],
      "webOrigins": ["${PUBLIC_PLATFORM_URL}"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [{
        "name": "institution-id",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "user.attribute": "institution_id",
          "claim.name": "institution_id",
          "jsonType.label": "String",
          "id.token.claim": "true",
          "access.token.claim": "true",
          "userinfo.token.claim": "true"
        }
      }]
    }
  ],
  "users": [
    {
      "username": "wang.researcher",
      "enabled": true,
      "firstName": "Wang",
      "lastName": "Researcher",
      "email": "wang.researcher@example.local",
      "emailVerified": true,
      "attributes": {"institution_id": ["longyun-demo"]},
      "realmRoles": ["researcher"],
      "credentials": [{ "type": "password", "value": "${INITIAL_RESEARCHER_PASSWORD}", "temporary": true }]
    },
    {
      "username": "li.researcher",
      "enabled": true,
      "firstName": "Li",
      "lastName": "Researcher",
      "email": "li.researcher@example.local",
      "emailVerified": true,
      "attributes": {"institution_id": ["longyun-demo"]},
      "realmRoles": ["researcher"],
      "credentials": [{ "type": "password", "value": "${INITIAL_RESEARCHER_PASSWORD}", "temporary": true }]
    },
    {
      "username": "zhang.processor",
      "enabled": true,
      "firstName": "Zhang",
      "lastName": "Processor",
      "email": "zhang.processor@example.local",
      "emailVerified": true,
      "attributes": {"institution_id": ["longyun-demo"]},
      "realmRoles": ["data_processor"],
      "credentials": [{ "type": "password", "value": "${INITIAL_PROCESSOR_PASSWORD}", "temporary": true }]
    },
    {
      "username": "chen.fieldadmin",
      "enabled": true,
      "firstName": "Chen",
      "lastName": "FieldAdmin",
      "email": "chen.fieldadmin@example.local",
      "emailVerified": true,
      "attributes": {"institution_id": ["longyun-demo"]},
      "realmRoles": ["field_admin"],
      "credentials": [{ "type": "password", "value": "${INITIAL_FIELD_ADMIN_PASSWORD}", "temporary": true }]
    }
  ]
}

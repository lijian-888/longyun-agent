# Copy to deploy/.env.multitenant, replace every CHANGE_ME value, and never
# commit the resulting file.  This example provisions two institutions.
COMPOSE_PROJECT_NAME=longyun-agent
RELEASE_TAG=multitenant-dev

PUBLIC_PLATFORM_URL=https://longyun-agent.institute.local:8443
PUBLIC_PLATFORM_HOST=longyun-agent.institute.local
HTTPS_PORT=8443
TLS_CERT_FILE=./deploy/certs/server.crt
TLS_KEY_FILE=./deploy/certs/server.key

# Legacy shared database remains the shared Keycloak database in this overlay.
POSTGRES_PASSWORD=CHANGE_ME_KEYCLOAK_HOST_DB
KEYCLOAK_DATABASE_PASSWORD=CHANGE_ME_KEYCLOAK_SCHEMA
# The base Compose file is interpolated before this overlay is merged. This
# fallback is never used as either institution's business-database credential.
APP_DATABASE_PASSWORD=CHANGE_ME_UNUSED_LEGACY_FALLBACK
CONTROL_POSTGRES_PASSWORD=CHANGE_ME_CONTROL_DATABASE
ORG_A_POSTGRES_PASSWORD=CHANGE_ME_ORG_A_DATABASE
ORG_B_POSTGRES_PASSWORD=CHANGE_ME_ORG_B_DATABASE
ORG_A_APP_DATABASE_PASSWORD=CHANGE_ME_ORG_A_APP_DATABASE
ORG_B_APP_DATABASE_PASSWORD=CHANGE_ME_ORG_B_APP_DATABASE
REDIS_PASSWORD=CHANGE_ME_REDIS

MINIO_ROOT_USER=longyun-storage-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT
# Pinned images prevent an unreviewed MinIO upgrade during an ordinary restart.
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z-cpuv1
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z-cpuv1
# Docker stores this named volume below its data root. On the inspected sandbox
# host that is /home/docker-data, which has approximately 1.6 TiB available.
MINIO_DATA_VOLUME_NAME=longyun-agent-minio-data
ORG_A_MINIO_ACCESS_KEY=longyun-org-a
ORG_A_MINIO_SECRET_KEY=CHANGE_ME_ORG_A_OBJECT_STORAGE
ORG_A_MINIO_BACKUP_ACCESS_KEY=longyun-org-a-backup
ORG_A_MINIO_BACKUP_SECRET_KEY=CHANGE_ME_ORG_A_BACKUP_STORAGE
ORG_B_MINIO_ACCESS_KEY=longyun-org-b
ORG_B_MINIO_SECRET_KEY=CHANGE_ME_ORG_B_OBJECT_STORAGE
ORG_B_MINIO_BACKUP_ACCESS_KEY=longyun-org-b-backup
ORG_B_MINIO_BACKUP_SECRET_KEY=CHANGE_ME_ORG_B_BACKUP_STORAGE
# Initial best-effort quotas. They protect shared sandbox capacity but are not
# a substitute for filesystem monitoring and alerting.
ORG_A_MINIO_DATA_QUOTA=200GiB
ORG_A_MINIO_BACKUP_QUOTA=200GiB
ORG_B_MINIO_DATA_QUOTA=200GiB
ORG_B_MINIO_BACKUP_QUOTA=200GiB
# Leave blank unless the MinIO server is connected to a real KMS/KES service.
ORG_A_MINIO_KMS_KEY_ID=
ORG_B_MINIO_KMS_KEY_ID=

KEYCLOAK_ADMIN_USERNAME=platform-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
INITIAL_RESEARCHER_PASSWORD=CHANGE_ME_INITIAL_RESEARCHER
INITIAL_PROCESSOR_PASSWORD=CHANGE_ME_INITIAL_PROCESSOR
INITIAL_FIELD_ADMIN_PASSWORD=CHANGE_ME_INITIAL_FIELD_ADMIN

ENABLE_SOURCE_DEDUPLICATION=true
ENABLE_LEGACY_DEMO_SEEDS=false
TENANT_DB_POOL_SIZE=8
TENANT_DB_MAX_OVERFLOW=8
AGENT_WORKER_CONCURRENCY=2
AGENT_QUEUE_LIMITS_ENABLED=false
AGENT_MAX_ACTIVE_PER_USER=2
AGENT_MAX_ACTIVE_PER_INSTITUTION=16
AGENT_WORKFLOW_MAX_ATTEMPTS=3
AGENT_WORKFLOW_LEASE_SECONDS=300
AGENT_WORKFLOW_HEARTBEAT_SECONDS=30

MINERU_MODEL_SOURCE=modelscope
MINERU_BACKEND=pipeline
MINERU_PARSE_TIMEOUT_SECONDS=900
MINERU_REQUEST_TIMEOUT_SECONDS=960
KNOWLEDGE_DOCUMENT_CONCURRENCY=1
DOCLING_DOCUMENT_TIMEOUT_SECONDS=600
BGE_M3_MODEL_SOURCE=modelscope
BGE_M3_MODEL_REPOSITORY=BAAI/bge-m3
BGE_M3_HF_ENDPOINT=
RICE_GFF3_PATH=

LONGYUN_LLM_PROVIDER_NAME=CherryIn
LONGYUN_LLM_BASE_URL=https://open.cherryin.net/v1
LONGYUN_LLM_MODEL=agent/qwen3.5-flash
LONGYUN_LLM_API_KEY=
LONGYUN_LLM_ALIAS=longyun-sandbox
LONGYUN_LLM_DEPLOYMENT_MODE=external_api
LONGYUN_RESEARCH_TEXT_PROTOCOL=plain_evidence
LONGYUN_DATA_ENVIRONMENT=institution_private
# Explicitly approved for this deployment; requests still require an external
# transfer acknowledgement and are written to the model-usage audit trail.
LONGYUN_ALLOW_EXTERNAL_PRIVATE_EVIDENCE=true
LONGYUN_ALLOW_EXTERNAL_WEB_SEARCH=false
TAVILY_API_KEY=

ACPS_AIP_ENABLED=false
LONGYUN_AIC=
ACPS_REQUIRE_MTLS_PROXY=true
ACPS_IDENTITY_BINDINGS_JSON={}
LONGYUN_ACS_RPC_URL=
LONGYUN_ACS_AMQP_URL=

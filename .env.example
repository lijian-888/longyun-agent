# Copy this file to .env for the desensitized CherryIn sandbox.
LONGYUN_LLM_PROVIDER_NAME=CherryIn
LONGYUN_LLM_API_KEY=
LONGYUN_LLM_BASE_URL=https://open.cherryin.net/v1
LONGYUN_LLM_MODEL=agent/qwen3.5-flash
LONGYUN_LLM_ALIAS=longyun-sandbox
LONGYUN_LLM_DEPLOYMENT_MODE=external_api
LONGYUN_DATA_ENVIRONMENT=sandbox_desensitized
LONGYUN_ALLOW_EXTERNAL_PRIVATE_EVIDENCE=false
LONGYUN_ALLOW_EXTERNAL_WEB_SEARCH=false

# Optional: current public paper and research reference search. This remains
# disabled unless LONGYUN_ALLOW_EXTERNAL_WEB_SEARCH is also set to true.
TAVILY_API_KEY=

# Change these in any non-demo environment before the first database start.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
APP_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

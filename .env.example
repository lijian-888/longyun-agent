# Copy this file to .env before a demo that needs Shennong.
SHENNONG_API_KEY=
SHENNONG_API_BASE_URL=https://api.agent-tech.cc/api/v1
SHENNONG_MODEL=sn

# Institution-scoped raw/structured data plane.
INSTITUTION_DATA_ENABLED=true
MINIO_ROOT_USER=longyun-minio
MINIO_ROOT_PASSWORD=longyun_minio_demo_2026
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# ACPs v2.1 runtime. Keep AIC empty until Registry approval assigns it.
ACPS_ENABLED=true
ACPS_ROLE=hybrid
ACPS_AIC=
ACPS_AGENT_NAME=隆耘 Agent 育种智能体
ACPS_AGENT_VERSION=1.0.0
ACPS_PUBLIC_BASE_URL=http://localhost:5183
ACPS_DOCUMENTATION_URL=https://github.com/lijian-888/longyun-agent/blob/codex/main-rework/docs/ACPS-INTEGRATION.md
ACPS_RPC_URL=http://localhost:5183/acps/rpc
ACPS_DISCOVERY_BASE_URL=
ACPS_REQUIRE_REGISTERED_LEADER=false
ACPS_ALLOWED_PARTNER_HOSTS=
ACPS_LEADER_TASK_RETENTION_SECONDS=3600
ACPS_PROVIDER_DOMAIN=
ACPS_PROVIDER_DOMAIN_REGISTRATION_NUMBER=
ACPS_PROVIDER_DOMAIN_REGISTRATION_TYPE=

# Enable these only after installing ACPs CA certificates under
# deploy/acps/runtime. Production Partner ingress must verify client certs.
ACPS_MTLS_ENABLED=false
ACPS_REQUIRE_VERIFIED_CLIENT=false
ACPS_CLIENT_CERT_FILE=/data/acps/client.pem
ACPS_CLIENT_KEY_FILE=/data/acps/client-key.pem
ACPS_TRUST_BUNDLE_FILE=/data/acps/trust-bundle.pem

# Group Leader remains disabled until the platform provides RabbitMQ, the
# mq-auth service, a formal AIC and credentials. Do not use demo credentials in production.
ACPS_GROUP_ENABLED=false
ACPS_RABBITMQ_HOST=
ACPS_RABBITMQ_PORT=5671
ACPS_RABBITMQ_VHOST=acps
ACPS_RABBITMQ_USER=
ACPS_RABBITMQ_PASSWORD=
ACPS_GROUP_AUTH_SERVICE_URL=
ACPS_GROUP_INVITATION_TIMEOUT_SECONDS=300

# Optional: current public paper and research reference search. Keep this on the server only.
TAVILY_API_KEY=

# Change these in any non-demo environment before the first database start.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
APP_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

# Copy this file to .env before a demo that needs Shennong.
SHENNONG_API_KEY=
SHENNONG_API_BASE_URL=https://api.agent-tech.cc/api/v1
SHENNONG_MODEL=sn

# Optional: current public paper and research reference search. Keep this on the server only.
TAVILY_API_KEY=

# Change these in any non-demo environment before the first database start.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_USE
APP_DATABASE_PASSWORD=CHANGE_ME_BEFORE_USE
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE

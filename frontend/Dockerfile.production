FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite substitutes VITE_* values at build time.  The server deployment file
# supplies the public Keycloak URL, while all API requests remain same-origin
# at /api and are proxied by Nginx.
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM=rice-research
ARG VITE_KEYCLOAK_CLIENT_ID=rice-research-web
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM \
    VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.lan.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
